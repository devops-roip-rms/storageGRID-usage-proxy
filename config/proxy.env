# StorageGRID Usage Proxy configuration
# EDIT ONLY THE FOUR REQUIRED VALUES in the first section before testing.

# ===== REQUIRED: EDIT THESE 4 VALUES =====
STORAGEGRID_BASE_URL=https://<STORAGEGRID_HOST_OR_IP>
STORAGEGRID_USERNAME=<STORAGEGRID_USERNAME>
STORAGEGRID_ACCOUNT_ID=<STORAGEGRID_ACCOUNT_ID>
STORAGEGRID_PASSWORD=<STORAGEGRID_PASSWORD>

# API paths
AUTH_PATH=/api/v4/authorize
USAGE_PATH=/api/v4/org/usage

# ===== Authorize request details =====
AUTH_BOOTSTRAP_BEARER=<AUTH_BOOTSTRAP_BEARER>
AUTH_CSRF_HEADER_VALUE=<AUTH_CSRF_HEADER_VALUE>
AUTH_COOKIE=true
AUTH_CSRF_TOKEN=false

# ===== Token lifecycle =====
TOKEN_REFRESH_HOURS=10
REFRESH_RETRY_SECONDS=300

# ===== Upstream HTTP/TLS =====
HTTP_TIMEOUT_SECONDS=30
MAX_RESPONSE_BYTES=10485760
TLS_VERIFY=true
CA_BUNDLE=

# ===== Local endpoint used by HTTP-SNIFFER =====
# Use 0.0.0.0 if HTTP-SNIFFER is in Docker and must reach this host by gateway IP.
PROXY_BIND_HOST=0.0.0.0
PROXY_PORT=8787

# Optional static key between HTTP-SNIFFER and this proxy. Leave empty in a
# sufficiently restricted closed network, or set a value and configure the
# same X-StorageGRID-Proxy-Key header in HTTP-SNIFFER.
PROXY_API_KEY=

LOG_LEVEL=INFO
