# StorageGRID Usage Proxy runtime configuration
# EDIT THIS FILE ONLY before testing.

# StorageGRID Tenant Management API
# Use the base URL only (scheme + host[:port]), without /api/v4/...
STORAGEGRID_BASE_URL=https://<STORAGEGRID_BASE_URL>
STORAGEGRID_USERNAME=<USERNAME>
STORAGEGRID_ACCOUNT_ID=<ACCOUNT_ID>
STORAGEGRID_PASSWORD=<STORAGEGRID_PASSWORD>

# API paths confirmed for this environment
AUTH_PATH=/api/v4/authorize
USAGE_PATH=/api/v4/org/usage

# Token lifecycle
TOKEN_REFRESH_HOURS=10
REFRESH_RETRY_SECONDS=300

# Upstream HTTP behavior
HTTP_TIMEOUT_SECONDS=30
MAX_RESPONSE_BYTES=10485760

# TLS
# Keep true in production. If the StorageGRID certificate chains to a CA already
# trusted by this server, leave CA_BUNDLE empty. Otherwise place the PEM CA file
# under certs/ and set CA_BUNDLE=certs/<filename>.pem.
TLS_VERIFY=true
CA_BUNDLE=

# Local endpoint used by HTTP-SNIFFER
# 0.0.0.0 is appropriate when the sniffer is a Docker container that reaches
# this host through the Splunk-gateway IP. HTTP-SNIFFER itself should use the
# real gateway IP, not 0.0.0.0.
PROXY_BIND_HOST=0.0.0.0
PROXY_PORT=8787

# Optional static key between HTTP-SNIFFER and this proxy.
# Closed-network deployments can leave this empty if network access is already
# appropriately restricted. If set, HTTP-SNIFFER must send header:
# X-StorageGRID-Proxy-Key: <this value>
PROXY_API_KEY=

LOG_LEVEL=INFO
