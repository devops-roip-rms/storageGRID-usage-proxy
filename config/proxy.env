# StorageGRID Usage Proxy configuration
# EDIT ONLY THE FIVE REQUIRED PRODUCTION VALUES in the first section before testing.

# ===== REQUIRED: EDIT THESE 5 PRODUCTION VALUES =====
STORAGEGRID_BASE_URL=https://<STORAGEGRID_HOST_OR_IP>
STORAGEGRID_USERNAME=<STORAGEGRID_USERNAME>
STORAGEGRID_ACCOUNT_ID=<STORAGEGRID_ACCOUNT_ID>
STORAGEGRID_PASSWORD=<STORAGEGRID_PASSWORD>
# Strong local shared secret required for the HTTP-SNIFFER -> proxy request
# when PROXY_BIND_HOST is non-loopback, including the packaged 0.0.0.0 default.
PROXY_API_KEY=

# API paths
AUTH_PATH=/api/v4/authorize
USAGE_PATH=/api/v4/org/usage

# ===== Token lifecycle =====
TOKEN_REFRESH_HOURS=10
REFRESH_RETRY_SECONDS=300
# /readyz returns 503 after this long of continuous failed refreshes.
# Default: max(3 * REFRESH_RETRY_SECONDS, 900).
STALE_TOKEN_WARNING_SECONDS=900

# ===== Upstream HTTP/TLS =====
HTTP_TIMEOUT_SECONDS=30
MAX_RESPONSE_BYTES=10485760
TLS_VERIFY=true
CA_BUNDLE=

# ===== Local endpoint used by HTTP-SNIFFER =====
# Use 0.0.0.0 if HTTP-SNIFFER is in Docker and must reach this host by gateway IP.
PROXY_BIND_HOST=0.0.0.0
PROXY_PORT=8787

# Static key between HTTP-SNIFFER and this proxy. This is required whenever
# PROXY_BIND_HOST is non-loopback (including 0.0.0.0). Configure the same
# X-StorageGRID-Proxy-Key header in HTTP-SNIFFER.
# Do not enable this except for an explicitly accepted insecure deployment.
# A non-loopback bind without PROXY_API_KEY otherwise fails at startup.
ALLOW_UNAUTHENTICATED_NONLOOPBACK=false
LOG_LEVEL=INFO